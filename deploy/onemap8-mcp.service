# systemd unit for the hosted HTTP transport.
#
#   sudo cp deploy/onemap8-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now onemap8-mcp
#   sudo journalctl -u onemap8-mcp -f
#
# Assumes the plugin is checked out at /opt/onemap8-mcp and built (`npm ci &&
# npm run build`), owned by a dedicated unprivileged user.

[Unit]
Description=OneMap8 MCP server (Streamable HTTP transport)
Documentation=file:///opt/onemap8-mcp/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onemap-mcp
Group=onemap-mcp
WorkingDirectory=/opt/onemap8-mcp
ExecStart=/usr/bin/node /opt/onemap8-mcp/dist/http.js
Restart=on-failure
RestartSec=5

# Config comes from the gitignored .env in WorkingDirectory. Keep it 600 and
# owned by this user. ONEMAP_TOKEN there is only a fallback: with
# ONEMAP_HTTP_PASSTHROUGH_AUTH=true every request carries its own token, which
# is what keeps testers scoped to their own OneMap permissions.
Environment=NODE_ENV=production
Environment=PORT=3000

# The process only needs outbound HTTPS to the OneMap API and its own port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/onemap8-mcp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
