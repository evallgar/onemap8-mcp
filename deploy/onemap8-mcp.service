# systemd unit for the hosted HTTP transport.
#
#   sudo cp deploy/onemap8-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now onemap8-mcp
#   sudo journalctl -u onemap8-mcp -f
#
# Assumes the plugin is checked out at /opt/onemap8-mcp and built (`npm ci &&
# npm run build`), owned by a dedicated unprivileged user.

[Unit]
Description=OneMap8 MCP server (Streamable HTTP transport)
Documentation=file:///opt/onemap8-mcp/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onemap-mcp
Group=onemap-mcp
WorkingDirectory=/opt/onemap8-mcp
ExecStart=/usr/bin/node /opt/onemap8-mcp/dist/http.js
Restart=on-failure
RestartSec=5

# Config comes from the gitignored .env in WorkingDirectory. Keep it 600 and
# owned by this user. ONEMAP_TOKEN there is only a fallback: with
# ONEMAP_HTTP_PASSTHROUGH_AUTH=true every request carries its own token, which
# is what keeps testers scoped to their own OneMap permissions.
Environment=NODE_ENV=production

# PORT is deliberately NOT set here — it comes from .env in WorkingDirectory.
# Setting it here would silently win over .env, because real environment
# variables take precedence over the file. Note that 3000 is a common default
# and is often already taken (application servers, dev tooling); check with
# `ss -tlnp | grep <port>` before choosing one.

# This commonly shares a small host with the tracking server itself. A ceiling
# means a runaway request here gets this process killed rather than letting the
# kernel's OOM killer pick a victim — which could be the tracking server.
# Steady state is well under 150M; raise these if the logs show restarts.
MemoryHigh=200M
MemoryMax=300M
Environment=NODE_OPTIONS=--max-old-space-size=192

# The process only needs outbound HTTPS to the OneMap API and its own port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/onemap8-mcp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
