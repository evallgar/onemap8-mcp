# --- Connection -------------------------------------------------------------

# Base URL of the OneMap8 API, including the /api suffix.
ONEMAP_URL=https://your-server.example.com/api

# Authentication. Use ONE of the following.
#
# 1. API token (recommended). Generate one in the OneMap8 UI under
#    Settings -> User -> ... -> or via POST /session/token. Sent as a
#    Bearer token, and scoped to that user's permissions.
ONEMAP_TOKEN=

# 2. Basic auth with the account's own credentials. Simpler to get started,
#    but the password sits in this file in plain text. Prefer a token.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- Guardrails -------------------------------------------------------------

# When true, every mutating tool (create/update/delete, command dispatch) is
# refused and the server exposes read + report tools only.
ONEMAP_READONLY=false

# When false, the onemap_send_command tool is disabled. Command dispatch has
# physical consequences on vehicles (engine cutoff, door locks), so turn this
# off for any deployment where an LLM should not be able to reach hardware.
ONEMAP_ALLOW_COMMANDS=true

# When false, irreversible / infrastructure-level operations are refused:
# deleting position history, rebooting the server, writing server files,
# and deleting users. Leave off unless you specifically need them.
ONEMAP_ALLOW_DANGEROUS=false

# --- Behaviour --------------------------------------------------------------

# Max rows returned to the model per report/list call before truncation.
# Keeps large fleet reports from blowing up the context window.
ONEMAP_MAX_ROWS=200

# Request timeout in milliseconds.
ONEMAP_TIMEOUT_MS=30000

# --- HTTP transport only (npm run start:http) --------------------------------

PORT=3000

# Comma-separated list of allowed Origin headers for browser-based clients.
# Leave empty to reject all cross-origin browser requests (DNS-rebinding guard).
ONEMAP_ALLOWED_ORIGINS=

# When true, the HTTP transport takes each caller's OneMap token from the
# incoming Authorization header instead of ONEMAP_TOKEN, so one deployment can
# serve many users, each scoped to their own OneMap permissions.
ONEMAP_HTTP_PASSTHROUGH_AUTH=true
